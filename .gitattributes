# Normalize source files; keep Unity assets and their metadata together.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=lf
*.shader text eol=lf
*.jslib text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.inputactions text eol=lf
*.scenetemplate text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
